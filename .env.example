# Copy to .env and adjust.

# A name listed in Nextcloud's trusted_domains (host or host:port).
NEXTCLOUD_HOST=cloud.example.com

# Where Nextcloud answers on the Docker network, and that network's name.
NEXTCLOUD_UPSTREAM=nextcloud:80
NEXTCLOUD_NETWORK=nextcloud_default

# Port the app is published on.
PORT=8093

# Downloader: folder in each user's files, and downloads that run at once.
DOWNLOAD_DIR=/Downloads
DOWNLOAD_WORKERS=2

# DNS-over-HTTPS servers the downloader looks up site names with.
DOH_UPSTREAM=https://1.1.1.1/dns-query
DOH_FALLBACK=https://8.8.8.8/dns-query

# Optional: send these downloader sites through Cloudflare WARP, for sites your
# network blocks by address (comma-separated names as in Downloads/<site>/).
# COMPOSE_PROFILES=warp starts the WARP proxy; it registers an anonymous device.
# COMPOSE_PROFILES=warp
# PROXY_SITES=kemono
